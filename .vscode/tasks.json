{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "component-preview-build",
            "type": "process",
            "command": "npm.cmd",
            "args": [
                "run",
                "component-preview:build"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "open-component-preview-browser",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\.vscode\\start-edge-debug.ps1",
                "http://127.0.0.1:3000/__tests__/component-preview/index.html?vscode-livepreview=true"
            ],
            "problemMatcher": []
        },
        {
            "label": "debug-component-preview",
            "dependsOn": [
                "component-preview-build",
                "open-component-preview-browser"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
