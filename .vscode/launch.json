{
    // IntelliSense を使用して利用可能な属性を学べます。
    // 既存の属性の説明をホバーして表示します。
    // 詳細情報は次を確認してください: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Mine コンポーネントテストのデバッグ",
            "request": "attach",
            "type": "msedge",
            "address": "127.0.0.1",
            "port": 9223,
            "urlFilter": "http://127.0.0.1:3000/__tests__/ui-components/mine/mine.html*",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "debug-mine"
        },
        {
            "name": "MineField コンポーネントテストのデバッグ",
            "request": "attach",
            "type": "msedge",
            "address": "127.0.0.1",
            "port": 9223,
            "urlFilter": "http://127.0.0.1:3000/__tests__/ui-components/mine/mine-field.html*",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "debug-mine-field"
        },
        {
            "name": "Mine コンポーネントテストのデバッグ（VS Code内蔵ブラウザー）",
            "request": "launch",
            "type": "editor-browser",
            "url": "http://127.0.0.1:3000/__tests__/ui-components/mine/mine.html?vscode-livepreview=true",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "build-ui-components"
        },
        {
            "name": "MineField コンポーネントテストのデバッグ（VS Code内蔵ブラウザー）",
            "request": "launch",
            "type": "editor-browser",
            "url": "http://127.0.0.1:3000/__tests__/ui-components/mine/mine-field.html?vscode-livepreview=true",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "build-ui-components"
        }
    ]
}
